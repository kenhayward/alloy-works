    "/v1/samples": {
      "post": {
        "operationId": "requestSample",
        "summary": "Ask for a sample PDF of this environment, which a worker makes",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "202": {
            "description": "Asked for; a worker will make it",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "done",
                        "failed"
                      ]
                    },
                    "download": {
                      "description": "A link to the PDF, good for a few minutes, once a worker has made it",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "state",
                    "download"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No session, or not one this environment issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "This environment has nowhere to keep documents yet",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every error takes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
