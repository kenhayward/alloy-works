{
  "openapi": "3.1.0",
  "info": {
    "title": "Alloy Works",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-aw_session"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the service is up. Answers on any hostname",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every error takes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Who is signed in, and to which environment",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in principal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The principal, stable for as long as the environment exists"
                    },
                    "displayName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "environment": {
                      "type": "string",
                      "description": "The environment signed in to, as its people see it"
                    }
                  },
                  "required": [
                    "id",
                    "displayName",
                    "email",
                    "environment"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No session, or not one this environment issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every error takes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
