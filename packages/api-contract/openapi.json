{
  "openapi": "3.1.0",
  "info": {
    "title": "Alloy Works",
    "version": "1"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the service is up. Answers on any hostname",
        "responses": {
          "200": {
            "description": "The service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every error takes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenant": {
      "get": {
        "operationId": "getTenant",
        "summary": "The environment this address serves, as its sign-in page shows it",
        "responses": {
          "200": {
            "description": "The environment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "What this environment is called, as its own people see it"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No environment is served at this address",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every error takes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Stable and machine-readable: branch on this, never on the message"
                    },
                    "message": {
                      "type": "string",
                      "description": "For people. It may change between releases"
                    },
                    "rule": {
                      "description": "The requirement or rule that refused the request, where one did",
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Quote this when reporting a problem"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "traceId"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
