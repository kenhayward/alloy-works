{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Alloy Works stream",
    "version": "1",
    "description": "What `GET /v1/stream` sends, as Server-Sent Events: each frame's `event` is a message's name, and its `data` that message's payload. Opened with a signed-in session alone, never a token. Every connection begins with `snapshot`; events are not replayed, so a reconnect is a connect (API-017). `?document=` or `?component=` scopes it to one thing the viewer may read, else it is answered 404; without either it is the environment's own stream."
  },
  "channels": {
    "stream": {
      "address": "/v1/stream",
      "messages": {
        "snapshot": {
          "$ref": "#/components/messages/snapshot"
        },
        "lock": {
          "$ref": "#/components/messages/lock"
        },
        "presence": {
          "$ref": "#/components/messages/presence"
        },
        "presence_left": {
          "$ref": "#/components/messages/presence_left"
        },
        "outline": {
          "$ref": "#/components/messages/outline"
        },
        "workflow": {
          "$ref": "#/components/messages/workflow"
        },
        "inbox": {
          "$ref": "#/components/messages/inbox"
        },
        "permissions": {
          "$ref": "#/components/messages/permissions"
        },
        "sample": {
          "$ref": "#/components/messages/sample"
        }
      }
    },
    "assistantRun": {
      "address": "/v1/documents/{id}/assistant/runs",
      "description": "What `POST /v1/documents/{id}/assistant/runs` answers, as Server-Sent Events: `run` first, then the model's text, its tool calls and their results, and its proposals as they come, and `ended` or `failed` last. Closing the request ends the run.",
      "parameters": {
        "id": {
          "description": "The document"
        }
      },
      "messages": {
        "run": {
          "$ref": "#/components/messages/assistant_run"
        },
        "text": {
          "$ref": "#/components/messages/assistant_text"
        },
        "tool_call": {
          "$ref": "#/components/messages/assistant_tool_call"
        },
        "tool_result": {
          "$ref": "#/components/messages/assistant_tool_result"
        },
        "proposal": {
          "$ref": "#/components/messages/assistant_proposal"
        },
        "ended": {
          "$ref": "#/components/messages/assistant_ended"
        },
        "failed": {
          "$ref": "#/components/messages/assistant_failed"
        }
      }
    }
  },
  "operations": {
    "receive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/stream"
      },
      "messages": [
        {
          "$ref": "#/channels/stream/messages/snapshot"
        },
        {
          "$ref": "#/channels/stream/messages/lock"
        },
        {
          "$ref": "#/channels/stream/messages/presence"
        },
        {
          "$ref": "#/channels/stream/messages/presence_left"
        },
        {
          "$ref": "#/channels/stream/messages/outline"
        },
        {
          "$ref": "#/channels/stream/messages/workflow"
        },
        {
          "$ref": "#/channels/stream/messages/inbox"
        },
        {
          "$ref": "#/channels/stream/messages/permissions"
        },
        {
          "$ref": "#/channels/stream/messages/sample"
        }
      ]
    },
    "receiveAssistantRun": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/assistantRun"
      },
      "messages": [
        {
          "$ref": "#/channels/assistantRun/messages/run"
        },
        {
          "$ref": "#/channels/assistantRun/messages/text"
        },
        {
          "$ref": "#/channels/assistantRun/messages/tool_call"
        },
        {
          "$ref": "#/channels/assistantRun/messages/tool_result"
        },
        {
          "$ref": "#/channels/assistantRun/messages/proposal"
        },
        {
          "$ref": "#/channels/assistantRun/messages/ended"
        },
        {
          "$ref": "#/channels/assistantRun/messages/failed"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "snapshot": {
        "name": "snapshot",
        "summary": "The state now, sent first on every connection; events follow and apply as state",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "locks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "description": "An id, as the API names the thing elsewhere"
                      },
                      "holder": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "An id, as the API names the thing elsewhere"
                              },
                              "name": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "id",
                              "name"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Who holds it; null once it is free"
                      },
                      "expectedRelease": {
                        "description": "When it is free unless its holder goes on working, in UTC; null once it is free",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "taking": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "by": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "description": "An id, as the API names the thing elsewhere"
                                  },
                                  "name": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  }
                                },
                                "required": [
                                  "id",
                                  "name"
                                ],
                                "additionalProperties": false
                              },
                              "until": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "by",
                              "until"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Somebody asking to take it over, and when its holder's grace to keep it ends (COL-047); null where nobody is"
                      }
                    },
                    "required": [
                      "component",
                      "holder",
                      "expectedRelease",
                      "taking"
                    ],
                    "additionalProperties": false,
                    "description": "A component's lock, as it now stands (COL-007)"
                  },
                  "description": "Every held lock in the scope the viewer may read"
                }
              },
              "required": [
                "locks"
              ],
              "additionalProperties": false,
              "description": "A document's or a component's stream, as it stands when it opens"
            },
            {
              "type": "object",
              "properties": {
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "An id, as the API names the thing elsewhere"
                      },
                      "state": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "state"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "samples"
              ],
              "additionalProperties": false,
              "description": "The environment's own stream, as it stands when it opens"
            }
          ]
        }
      },
      "lock": {
        "name": "lock",
        "summary": "A lock claimed, moved, released, or its expected release moved to another minute; sent on a document's or a component's stream to whoever may read the component",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "component": {
              "type": "string",
              "description": "An id, as the API names the thing elsewhere"
            },
            "holder": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "An id, as the API names the thing elsewhere"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who holds it; null once it is free"
            },
            "expectedRelease": {
              "description": "When it is free unless its holder goes on working, in UTC; null once it is free",
              "type": [
                "string",
                "null"
              ]
            },
            "taking": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "An id, as the API names the thing elsewhere"
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "until": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "by",
                    "until"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "Somebody asking to take it over, and when its holder's grace to keep it ends (COL-047); null where nobody is"
            }
          },
          "required": [
            "component",
            "holder",
            "expectedRelease",
            "taking"
          ],
          "additionalProperties": false,
          "description": "A component's lock, as it now stands (COL-007)"
        }
      },
      "presence": {
        "name": "presence",
        "summary": "Somebody's window beat or moved in the document; sent on its stream to everyone, redacted",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "viewer": {
              "type": "string",
              "description": "The window, as its own beats name it"
            },
            "person": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "An id, as the API names the thing elsewhere"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "external": {
                  "description": "From outside the organisation (IAM-045)",
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "component": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "An id, as the API names the thing elsewhere"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where they are; null between components, or where the viewer may not read it"
            },
            "mode": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "read",
                    "review",
                    "author"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "What they are doing; null where the viewer may not read where"
            },
            "beatAt": {
              "type": "string",
              "description": "When their window last said so, in UTC: live for 30 seconds, stale to 60, then absent"
            },
            "ageMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "How long before this was sent it beat, by the service's clock: what a viewer ages it by"
            }
          },
          "required": [
            "viewer",
            "person",
            "component",
            "mode",
            "beatAt",
            "ageMs"
          ],
          "additionalProperties": false,
          "description": "Somebody in the document, as the viewer may see them (COL-001 to COL-003, COL-055)"
        }
      },
      "presence_left": {
        "name": "presence_left",
        "summary": "A window left the stream's document",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "viewer": {
              "type": "string",
              "description": "An id, as the API names the thing elsewhere"
            }
          },
          "required": [
            "viewer"
          ],
          "additionalProperties": false,
          "description": "A window left the document, or fell silent past a minute"
        }
      },
      "outline": {
        "name": "outline",
        "summary": "The document's outline changed; sent on its stream",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "document": {
              "type": "string",
              "description": "An id, as the API names the thing elsewhere"
            }
          },
          "required": [
            "document"
          ],
          "additionalProperties": false,
          "description": "The stream's document has a new version: read its outline again (STR-066)"
        }
      },
      "workflow": {
        "name": "workflow",
        "summary": "A component or a document moved to another workflow state, its own or a save's; sent on its stream, and on a document's stream for a component in it, to whoever may read it",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "artifact": {
              "type": "string",
              "description": "The component or the document"
            },
            "state": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "artifact",
            "state"
          ],
          "additionalProperties": false,
          "description": "A component or a document moved to another workflow state (LIF-005)"
        }
      },
      "inbox": {
        "name": "inbox",
        "summary": "A notification was made for the viewer, at once or as a digest; sent on every stream they hold, and to nobody else",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false,
          "description": "A notification waits for the viewer: read the inbox (COL-063). It names nothing, so it says nothing the inbox would not"
        }
      },
      "permissions": {
        "name": "permissions",
        "summary": "Access changed in the environment; sent on every stream, which then ends",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false,
          "description": "Somebody's access changed; the stream ends after this, and its next connection is authorised afresh (API-016)"
        }
      },
      "sample": {
        "name": "sample",
        "summary": "A development sample's state; sent on the environment's own stream alone",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sample"
            },
            "id": {
              "type": "string",
              "description": "An id, as the API names the thing elsewhere"
            },
            "state": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "state"
          ],
          "additionalProperties": false,
          "description": "A development sample's state"
        }
      },
      "assistant_run": {
        "name": "run",
        "summary": "The run began: its identifier, and the endpoint it calls and whether that sits outside the data boundary",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "description": "An id, as the API names the thing elsewhere"
            },
            "endpoint": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "boundary": {
                  "type": "string",
                  "enum": [
                    "inside",
                    "outside"
                  ]
                }
              },
              "required": [
                "name",
                "boundary"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run",
            "endpoint"
          ],
          "additionalProperties": false
        }
      },
      "assistant_text": {
        "name": "text",
        "summary": "The model's answer, a piece at a time, as it is made",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "assistant_tool_call": {
        "name": "tool_call",
        "summary": "The model called one of its tools, with these arguments",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "input": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "id",
            "name",
            "input"
          ],
          "additionalProperties": false
        }
      },
      "assistant_tool_result": {
        "name": "tool_result",
        "summary": "What the tool answered, as the model was given it, and a summary for a person",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "summary": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "ok",
            "summary",
            "result"
          ],
          "additionalProperties": false
        }
      },
      "assistant_proposal": {
        "name": "proposal",
        "summary": "An edit proposed to a component, or a component proposed to be made, which changes nothing until its requester acts on it",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "An id, as the API names the thing elsewhere"
            },
            "number": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "component": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "An id, as the API names the thing elsewhere"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The component edited; null for one proposed to be made"
            },
            "against": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "An id, as the API names the thing elsewhere"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The version edited; null for one proposed to be made"
            },
            "creates": {
              "description": "Where, and under what title, a proposed component would be made",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "space": {
                      "type": "string",
                      "description": "An id, as the API names the thing elsewhere"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "space",
                    "title"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposed": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "id",
            "number",
            "component",
            "against",
            "proposed"
          ],
          "additionalProperties": false
        }
      },
      "assistant_ended": {
        "name": "ended",
        "summary": "The run ended: the model, its tokens and cost, and the citations kept and dropped",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokensIn": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "tokensOut": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "cost": {
              "type": [
                "string",
                "null"
              ]
            },
            "currency": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "description": "An id, as the API names the thing elsewhere"
                  },
                  "block": {
                    "type": "string"
                  }
                },
                "required": [
                  "component",
                  "block"
                ],
                "additionalProperties": false
              }
            },
            "dropped": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "description": "An id, as the API names the thing elsewhere"
                  },
                  "block": {
                    "type": "string"
                  }
                },
                "required": [
                  "component",
                  "block"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "outcome",
            "model",
            "tokensIn",
            "tokensOut",
            "cost",
            "currency",
            "citations",
            "dropped"
          ],
          "additionalProperties": false
        }
      },
      "assistant_failed": {
        "name": "failed",
        "summary": "The run failed, by code and reason, in the product’s words",
        "contentType": "application/json",
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "resetsAt": {
              "description": "With `model_rate_limited`: when a run is free again",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
