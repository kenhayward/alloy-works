# Normalise to LF in the repository regardless of the checkout platform. CI runs Linux and
# contributors are on Windows and macOS; without this, a file's line endings depend on who last
# touched it and diffs turn into whole-file rewrites.
* text=auto eol=lf

# Binary and generated files that must not be normalised.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary

# Office formats are ZIP archives. Left to the `text=auto` heuristic above, a checkout on a
# platform that normalises line endings can rewrite bytes inside the archive and produce a file
# that no longer opens - with a diff that says nothing was changed.
*.docx binary
*.dotx binary
*.xlsx binary
*.pptx binary
*.zip binary

