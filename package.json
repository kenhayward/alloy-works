{
  "name": "alloy-works",
  "version": "0.10.7",
  "private": true,
  "type": "module",
  "description": "Component Content Management System - web and desktop delivery from one renderer",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app": "pnpm --filter @alloy-works/domain build && concurrently -k --success first -n web,shell -c blue,magenta \"pnpm --filter @alloy-works/web dev\" \"pnpm --filter @alloy-works/desktop dev\"",
    "dev:web": "pnpm --filter @alloy-works/web dev",
    "dev:setup": "pnpm --filter @alloy-works/db dev:setup && pnpm --filter @alloy-works/objects dev:setup",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@alloy-works/e2e",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:e2e": "turbo run test --filter=@alloy-works/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
