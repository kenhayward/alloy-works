{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@alloy-works/desktop#test": {
      "dependsOn": ["^build", "build"]
    },
    "@alloy-works/db#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/service#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
