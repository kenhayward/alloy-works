{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@alloy-works/desktop#test": {
      "dependsOn": ["^build", "build"]
    },
    "@alloy-works/db#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/service#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/objects#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/worker#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/api-client#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/e2e#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "ALLOY_E2E_SERVICE",
        "ALLOY_E2E_IDP",
        "ALLOY_E2E_IDP_ISSUER",
        "ALLOY_E2E_STORE_AT"
      ]
    }
  }
}
