{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "ALLOY_TEST_DATABASE_URL",
    "ALLOY_TEST_OBJECT_STORE",
    "ALLOY_TEST_OBJECT_STORE_KEY",
    "ALLOY_TEST_OBJECT_STORE_SECRET",
    "ALLOY_TEST_SOURCE_PORT",
    "ALLOY_TEST_HTTP_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@alloy-works/desktop#test": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "@alloy-works/db#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/service#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/objects#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/worker#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/api-client#test": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/trace#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@alloy-works/e2e#test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "ALLOY_E2E_SERVICE",
        "ALLOY_E2E_IDP",
        "ALLOY_E2E_IDP_ISSUER",
        "ALLOY_E2E_STORE_AT",
        "ALLOY_E2E_COMPOSE_PROJECT"
      ]
    },
    "@alloy-works/browser#test:browser": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "ALLOY_BROWSER_SERVICE",
        "ALLOY_BROWSER_API",
        "ALLOY_BROWSER_IDP",
        "ALLOY_BROWSER_DATABASE",
        "ALLOY_BROWSER_STORE_AT",
        "ALLOY_BROWSER_STYLE_SEEDS",
        "ALLOY_BROWSER_STYLE_DUMP"
      ]
    }
  }
}
