{
  "name": "@alloy-works/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../deploy/worker.env src/main.ts",
    "start": "node dist/main.js",
    "fetch-typst": "tsx scripts/fetch-typst.ts",
    "fetch-verapdf": "tsx scripts/fetch-verapdf.ts",
    "fetch-ooxml-check": "tsx scripts/fetch-ooxml-check.ts"
  },
  "dependencies": {
    "@alloy-works/db": "workspace:^",
    "@alloy-works/domain": "workspace:^",
    "@alloy-works/objects": "workspace:^",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
