    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
