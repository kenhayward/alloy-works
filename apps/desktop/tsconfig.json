{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // The main process and the preload are bundled by esbuild into CommonJS (the UI plan, UI-I), so
    // the shell is written in import syntax and resolved as a bundler resolves it.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "vitest.config.mts"]
}
