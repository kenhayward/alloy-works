# Dependencies
node_modules/

# Build output
dist/
.tools/
out/
release/
*.tsbuildinfo

# Task cache
.turbo/

# Test output
coverage/

# Per-package Vitest JSON reports, read by `pnpm trace verify`. A build artifact of a test run,
# never committed.
.trace-results/

# Python bytecode, from the spike harnesses
__pycache__/

# A local override of the stack: your ports, your secrets, nobody else's business.
deploy/compose.override.yaml
*.pyc

# Editor / OS
.DS_Store
Thumbs.db
*.local

# Environment. The settings for running from source live in deploy/ as <app>.env, copied from the
# committed <app>.env.example beside them - so the names are ignored by shape, not by being called
# `.env`, and an example is exempt.
.env
.env.*
!.env.example
*.env
!*.env.example

# Local scratch beside the repository and never part of it - a listing written with
# `pnpm trace area --file`, a script somebody keeps for their own use.
untracked/

# Spike build output. The bundle is 2MB and is rebuilt by one esbuild command.
spikes/editor-framework/out/

# The Word validator's .NET build output, when it is built outside its image: `dotnet restore` and
# `dotnet build` write these beside the project.
apps/worker/tools/ooxml-check/bin/
apps/worker/tools/ooxml-check/obj/
