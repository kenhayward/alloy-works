[Unit]
Description=The firewall in front of Alloy Works's containers
After=docker.service
Requires=docker.service
# Again whenever Docker restarts, which rebuilds its chains.
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/alloy-works/firewall.sh

[Install]
WantedBy=docker.service multi-user.target
