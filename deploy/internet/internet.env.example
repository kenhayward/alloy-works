# compose.internet.yaml's settings. `deploy.sh settings` copies this to /etc/alloy-works/internet.env, only
# root reading it, and fills in each GENERATE. Fill in each CHANGE_ME yourself. Keep a copy somewhere safe:
# it is the only copy of the keys that seal the data.

# The three public names, and the reverse proxy's address, the only caller believed about who is calling.
ALLOY_APP_HOST=CHANGE_ME
ALLOY_IDP_HOST=CHANGE_ME
ALLOY_STORE_HOST=CHANGE_ME
PROXY_ADDRESS=CHANGE_ME

# Who it belongs to, and the one environment. Ids are lower case letters and digits.
ORGANISATION_ID=CHANGE_ME
ORGANISATION_NAME=CHANGE_ME
ENVIRONMENT_ID=CHANGE_ME
ENVIRONMENT_NAME=CHANGE_ME
FIRST_ADMINISTRATOR_EMAIL=CHANGE_ME

# Keycloak's mail, over STARTTLS.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME

# Where a failed deploy or backup is mailed, through the SMTP settings above.
ALERT_EMAIL=CHANGE_ME

# Backups, by restic: a repository off this machine (sftp:, rest:, s3: or a mounted path), and the key
# that encrypts it. Without that key the backups cannot be read, so keep a copy.
RESTIC_REPOSITORY=CHANGE_ME

# Builds fetch the bridge contract with this: a classic GitHub token with read:packages alone.
NODE_AUTH_TOKEN=CHANGE_ME

SIGN_IN_CLIENT_ID=alloy
OBJECT_STORE_BUCKET=alloy

# The first sign-in's password, which the first administrator must change.
KEYCLOAK_FIRST_ADMIN_PASSWORD=GENERATE
KEYCLOAK_ADMIN_PASSWORD=GENERATE
KEYCLOAK_DATABASE_PASSWORD=GENERATE
POSTGRES_SUPERUSER_PASSWORD=GENERATE
DELIVERED_PASSWORD=GENERATE
DATABASE_PASSWORD_SERVICE=GENERATE
DATABASE_PASSWORD_WORKER=GENERATE
DATABASE_PASSWORD_MIGRATOR=GENERATE
DATABASE_PASSWORD_RESTORER=GENERATE
DATABASE_PASSWORD_STEWARD=GENERATE
OBJECT_STORE_ADMIN_KEY=GENERATE
OBJECT_STORE_ADMIN_SECRET=GENERATE
SECRET_SIGN_IN_CLIENT=GENERATE
SECRET_SIGN_IN_STATE=GENERATE
RESTIC_PASSWORD=GENERATE

# Keys of 32 bytes in base64.
SECRET_OBJECT_STORE_KEY=GENERATE_KEY
SECRET_CONNECTOR_KEY=GENERATE_KEY
CONNECTOR_SEALING_KEY=GENERATE_KEY
SECRET_CONNECTOR_EMBED_KEY=GENERATE_KEY
SECRET_CONNECTOR_DELIVER_KEY=GENERATE_KEY
SECRET_CONNECTOR_REFERENCE_KEY=GENERATE_KEY
SECRET_CONNECTOR_MAIL_KEY=GENERATE_KEY
