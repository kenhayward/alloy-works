# The ports the compose stack publishes on 127.0.0.1. Compose reads `deploy/.env` - this directory,
# beside compose.yaml - so `cp deploy/.env.example deploy/.env` and change what you need. The copy is
# git-ignored; this example is not. Every value here is the default the stack uses without a copy.
#
# The service, the sign-in provider and the object store each listen inside their container on the
# same number they are published on: a sign-in redirect and a signed download link carry the address
# that made them, so the browser and the containers must reach each one by the same port.

# The API and the page, at http://dev.acme.localhost:<SERVICE_PORT>.
SERVICE_PORT=8088
# The stand-in sign-in provider, at http://idp.localhost:<IDP_PORT>.
IDP_PORT=9090
# The object store's S3 API, at http://store.localhost:<STORE_PORT>.
STORE_PORT=8333
# Postgres, published for running the suites and the service from source. Inside the stack the
# containers still reach it at postgres:5432.
POSTGRES_PORT=5432
