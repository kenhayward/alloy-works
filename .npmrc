# Fail the install rather than silently resolving a tree the lock file does not name.
# CI passes --frozen-lockfile explicitly; this makes a local `pnpm install` behave the
# same way once a lock file exists.
engine-strict=true

# Windows has a 260-character path limit, and NSIS's makensis.exe is not long-path aware: it
# reports a missing include for a file that is present, and the packaging build fails with no
# hint that the length is the problem. pnpm's default virtual-store name length is 120, which
# takes a nested include inside app-builder-lib past the limit on any reasonably deep checkout.
# Shortening the names buys back ~35 characters and costs nothing - pnpm appends a hash, so
# uniqueness is unaffected. Changing this needs a fresh install to take effect.
virtual-store-dir-max-length=50
